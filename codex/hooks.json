{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/codex-notify.sh\"",
            "timeout": 5,
            "statusMessage": "Tracking Codex session"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/codex-notify.sh\"",
            "timeout": 5,
            "statusMessage": "Sending completion notification"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/codex-notify.sh\"",
            "timeout": 5,
            "statusMessage": "Sending approval notification"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/codex-notify.sh\"",
            "timeout": 5,
            "statusMessage": "Updating Codex session"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/codex-notify.sh\"",
            "timeout": 5,
            "statusMessage": "Tracking Codex subagent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/codex-notify.sh\"",
            "timeout": 5,
            "statusMessage": "Tracking Codex subagent"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/dotfiles/codex/codex-notify.sh\"",
            "timeout": 3,
            "statusMessage": "Closing Codex session"
          }
        ]
      }
    ]
  }
}
